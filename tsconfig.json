{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "orca/worker": ["./types/worker.ts"],
      "orca/testing": ["./test/host.ts"]
    }
  },
  "include": ["src", "panel", "types", "test", "scripts"]
}
